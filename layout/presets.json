{
  "preset_buttonshy": {
    "name": "Buttonshy",
    "settings": {
      "_version": 2,
      "layoutMode": "doubleSided",
      "pageOrientation": "landscape",
      "grid": {
        "rows": 2,
        "columns": 3,
        "pageSize": "A4",
        "pageWidth": 297,
        "pageHeight": 210,
        "cardSize": "Poker Standard (MTG)",
        "imageWidth": 63,
        "imageHeight": 88,
        "bleed": 5,
        "borderWidth": 0,
        "crosshaircolor": "#000000",
        "borderColor": "#000000",
        "frontCheckbox": true,
        "backCheckbox": false,
        "frontBorderCheckbox": false,
        "backBorderCheckbox": false,
        "crosswidth": 0.1,
        "crosssize": 3,
        "cornerRadius": 0
      },
      "foldable": {
        "foldable_pageSize": "A4",
        "foldable_pageWidth": 210,
        "foldable_pageHeight": 297,
        "foldable_cardSize": "Poker Standard (MTG)",
        "foldable_cardWidth": 63,
        "foldable_cardHeight": 88,
        "foldable_printerMargin": 5,
        "foldable_foldingMargin": 5,
        "foldable_cardMargin": 0,
        "foldable_cutMargin": 5,
        "foldable_innerBorder": 0,
        "foldable_borderColorFront": "#000000",
        "foldable_borderColorBack": "#000000",
        "foldable_foldLinePreference": "auto",
        "foldable_cornerRadius": 0
      },
      "disabled": {
        "layoutMode": true,
        "cardSize": true,
        "gridSize": true,
        "crosshair": true,
        "borders": true,
        "foldPreference": true
      }
    }
  }
}
